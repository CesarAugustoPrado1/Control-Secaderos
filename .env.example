# Supabase - Connection string del pooler en modo SESION (puerto 5432).
#
# Lo sacas del boton "Connect" del dashboard, opcion "Session pooler".
# Reemplaza [YOUR-PASSWORD] por la contrasena de la base.
#
# IMPORTANTE: no uses el pooler de transaccion (puerto 6543). El driver
# postgres-js hace pipelining de consultas y ese modo no lo soporta: las
# pantallas quedan colgadas. El detalle esta en lib/db/index.ts.
DATABASE_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave para firmar las cookies de sesion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# PIN inicial del usuario admin que crea el seed (usuario: admin)
ADMIN_PIN="1234"

# Informe diario por WhatsApp (CallMeBot), lo dispara el cron de Vercel a las
# 22 hs. Ver "Informe diario por WhatsApp" en el README.
CRON_SECRET="cambiar-por-otra-clave-larga-y-aleatoria"
WHATSAPP_TELEFONO="+5493510000000"
CALLMEBOT_APIKEY="1234567"

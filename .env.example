# Supabase - Connection string en modo "Transaction pooler" (puerto 6543).
# Lo sacas de: Supabase > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Supabase - Connection string directa (puerto 5432), solo para migraciones y seed.
DIRECT_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave para firmar las cookies de sesion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# PIN inicial del usuario admin que crea el seed (usuario: admin)
ADMIN_PIN="1234"
